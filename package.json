{
  "name": "devbench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "changelog": "node scripts/changelog.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "devbench-cli": "node scripts/devbench-cli.mjs",
    "build:desktop": "DESKTOP_BUILD=1 npm run build && node packaging/desktop/scripts/prepare-standalone.mjs",
    "dist:mac": "npm run build:desktop && npm --prefix packaging/desktop ci && npm --prefix packaging/desktop run dist",
    "release:homebrew": "node scripts/release-homebrew.mjs"
  },
  "bin": {
    "devbench-cli": "./scripts/devbench-cli.mjs"
  },
